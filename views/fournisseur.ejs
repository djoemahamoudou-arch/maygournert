<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fournisseur - Maygourmet</title>
    <link rel="stylesheet" href="/css/fournisseur.css">
</head>

<body>

<header class="header">
    <h1>🍽️ Maygourmet</h1>
    <p>Gestion des fournisseurs</p>
</header>

<main class="main">

    <div class="card">
        <h2>Ajouter un fournisseur</h2>

        <form action="/api/fournisseur" method="post">

            <div class="form-group">
                <label>Nom</label>
                <input type="text" name="firstname" placeholder="Nom du fournisseur">
            </div>

            <div class="form-group">
                <label>Prénom</label>
                <input type="text" name="lastname" placeholder="Prénom">
            </div>

            <div class="form-group">
                <label>Produit</label>
                <input type="text" name="produit" placeholder="Produit fourni">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Prix (€)</label>
                    <input type="number" name="prix">
                </div>

                <div class="form-group">
                    <label>Quantité</label>
                    <input type="number" name="quantite">
                </div>
            </div>

            <div class="form-group">
                <label>Origine</label>
                <input type="text" name="origine" placeholder="Pays / Ville">
            </div>

            <div class="form-group">
                <label>Type</label>
                <input type="text" name="typee" placeholder="Ex: Alimentaire">
            </div>

            <button type="submit">Ajouter fournisseur</button>

        </form>
    </div>

</main>



</body>
</html>