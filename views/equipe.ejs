<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe</title>
    <link rel="stylesheet" href="/css/styleEquipe.css">
</head>
<body>
  
<header class="header">
    <h1>🍽️ May.Gourmet</h1>
</header>
    <!-- Inclure le fichier navbar.ejs pur avoir la barre de navigation -->

<%- include('navbar') -%>

<% resultatEquipe.forEach(resultat => {%>
    <div class="card">
             
  <div class="container">
  <img src="/sql/premium_photo-1739786995646-480d5cfd83dc.avif" alt="Avatar">
  <h3><b><%= resultat.nom %> <%= resultat.prenom %></b></h3>
  <p><strong>Email :</strong> <%= resultat.email %></p>
  <p><strong>Téléphone :</strong> <%= resultat.telephone %></p>
  <p><strong>Adresse :</strong> <%= resultat.adresse_postale %></p>
  <p><strong>Présentation :</strong> <%= resultat.presentation %></p>
  <p><strong>Date de recrutement :</strong> <%= resultat.date_recrutement %></p>
</div>
             

            <p><%= resultat.poste %></p>
            <input type="button" value="supprimer" onclick="supprimer('<%= resultat.id %>')">
            <input type="button" value="Modifie" id="bouttonModifier"  onclick="modifierEquipe('<%= resultat.id %>','<%= resultat.nom %>','<%= resultat.prenom %>','<%= resultat.email %>',' <%= resultat.telephone %>','<%= resultat.adresse_postale %>','<%= resultat.presentation %>','<%= resultat.date_recrutement %>')">
        </div>
    </div>
<% });%>


<button id="myBtn">Ajoute un m'embre</button>

<div id="teamContainer" class="team-container"></div>

<div id="myModal" class="modal">

  <div class="modal-content">
    <div class="modal-header">
      <span class="close">&times;</span>
      <h2>Formulaire de Contact</h2>
    </div>
<form action="/api/equipe" method="POST">
  <input type="text" name="nom" placeholder="Nom" required>
  <input type="text" name="prenom" placeholder="Prénom" required>
  <input type="email" name="email" placeholder="Email">
  <input type="text" name="telephone" placeholder="Téléphone" required>
  <input type="text" name="poste" placeholder="Poste" required>
  <input type="text" name="adresse_postale" placeholder="Adresse" required>
  <textarea name="presentation" placeholder="Présentation" required></textarea>
  <input type="date" name="date_recrutement">
  <button type="submit">Ajouter</button>
</form>
    </div>
  </div>

</div>



</body>





<script src="/script.js"></script>



</html>